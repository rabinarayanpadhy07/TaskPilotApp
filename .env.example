# Frontend build-time settings. Everything here ends up in the public JS bundle:
# never put secrets, database credentials or API keys in VITE_* variables.
# Copy to .env.local (gitignored) to override the defaults below.

# Base URL of the Django API as seen by the browser.
#   development: leave unset to use the Vite proxy (/api -> VITE_API_PROXY_TARGET)
#   production:  "/api" when the API is served on the same origin, or e.g. https://api.example.com/api
# VITE_API_BASE_URL=/api

# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
